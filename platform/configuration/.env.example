# ---------------------------------------------------------------------------
# A. ENVIRONMENT CONFIGURATION
# Copy to .env at the repository root. Never commit a filled-in copy.
# ---------------------------------------------------------------------------
APP_ENVIRONMENT=development           # development | test | staging | production
APP_NAME=genomic-platform
APP_LOG_LEVEL=INFO

# PostgreSQL (authoritative transactional database)
DATABASE_URL=postgresql+asyncpg://genomics:change-me@localhost:5432/genomics
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10

# Redis (cache / coordination / queues)
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=genomics-dev
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Large analytical data (Parquet / DuckDB)
ANALYTICS_PARQUET_ROOT=s3://genomics-dev/analytics
ANALYTICS_DUCKDB_MEMORY_LIMIT=2GB
ANALYTICS_DUCKDB_THREADS=2

# Transport / security
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
API_MAX_REQUEST_BODY_BYTES=2097152

# Authentication secrets. Required in every environment: the pepper is mixed into
# session and credential token hashes. Rotating it invalidates all sessions and
# outstanding verification / reset / invitation tokens.
AUTH_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# B. SECURITY POLICY (backend-enforced; values shown are the defaults)
# ---------------------------------------------------------------------------
SECURITY_SESSION_IDLE_MINUTES=60
SECURITY_SESSION_ABSOLUTE_HOURS=12
SECURITY_REAUTHENTICATION_WINDOW_MINUTES=15
SECURITY_MAX_ACTIVE_SESSIONS_PER_USER=10
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_MAX_FAILED_AUTHENTICATION_ATTEMPTS=5
SECURITY_ACCOUNT_LOCKOUT_MINUTES=15
SECURITY_EMAIL_VERIFICATION_TTL_HOURS=48
SECURITY_PASSWORD_RESET_TTL_MINUTES=60
SECURITY_INVITATION_TTL_HOURS=168
SECURITY_REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=true
SECURITY_ORGANIZATIONS_REQUIRE_PLATFORM_APPROVAL=true
SECURITY_AUTHENTICATION_RATE_LIMIT_ATTEMPTS=10
SECURITY_AUTHENTICATION_RATE_LIMIT_WINDOW_SECONDS=300
SECURITY_REGISTRATION_RATE_LIMIT_ATTEMPTS=5
SECURITY_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
SECURITY_RATE_LIMIT_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# C. SCIENTIFIC CONFIGURATION
# ---------------------------------------------------------------------------
SCIENTIFIC_ADAPTER=development        # development | http  (development is refused in production)
SCIENTIFIC_SERVICE_BASE_URL=
SCIENTIFIC_SERVICE_TOKEN=
SCIENTIFIC_REQUEST_TIMEOUT_SECONDS=30
SCIENTIFIC_REQUIRED_FOR_READINESS=false

# ---------------------------------------------------------------------------
# FRONTEND (public, non-secret only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENVIRONMENT=development
